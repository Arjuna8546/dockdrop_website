// Cloudflare Worker serving the static site from ./dist (free plan, no server code).
// Cloudflare Git builds: build command `npm run build`, deploy command `npx wrangler deploy`.
// The name must match the Worker in the dashboard.
{
  "name": "dockdrop-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
